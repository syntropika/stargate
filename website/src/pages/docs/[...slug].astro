---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { guides } from '../../lib/guides';
export async function getStaticPaths() {
  const entries = await getCollection('guides');
  return entries.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const title = guides.find(guide => guide.id === entry.id)?.label || entry.id;
---
<DocsLayout title={title} current={entry.id}>
  <Content />
  <a class="edit-link" href={`https://github.com/syntropika/stargate/edit/main/docs/${entry.id}.md`}>Edit this page on GitHub</a>
</DocsLayout>
