---
import SiteLayout from '../layouts/SiteLayout.astro';
import AsciiPortal from '../components/AsciiPortal.astro';
import Icon from '../components/Icon.astro';
import '../styles/landing.css';
import IntegrationExamples from '../components/IntegrationExamples.astro';
import { integrations } from '../lib/integrations';
---
<SiteLayout title="Authentication inside your app" home>
  <main id="main-content">
    <section class="landing-hero landing-frame" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">Authentication<br />inside your app.</h1>
        <p>Email/password or OIDC sign-in, sessions and API keys. One Rust runtime, embedded in your existing server.</p>
        <div class="hero-actions"><a class="primary-link" href="/docs/">Start building <Icon name="arrow" /></a><a class="repository-link" href="https://github.com/syntropika/stargate"><Icon name="github" /><span>View on GitHub</span></a></div>
      </div>
      <AsciiPortal />
    </section>
    <section class="installation" id="integration" aria-label="Install Stargate">
      <div class="installation-controls" data-installation data-language-tabs>
        <div class="install-tabs" role="tablist" aria-label="Choose your language">
          {integrations.map(({ id, label, guide }) => <button type="button" role="tab" data-language={id} id={`tab-${id}`} aria-controls={`install-${id}`} aria-selected={id === 'node'} tabindex={id === 'node' ? 0 : -1} data-guide={guide}>{label}</button>)}
        </div>
        {integrations.map(({ id, label, command, guide }) => <div class="install-panel" id={`install-${id}`} role="tabpanel" aria-labelledby={`tab-${id}`} hidden={id !== 'node'} tabindex="0">
          <div class="install-command">
            {command ? <><span class="shell-prompt" aria-hidden="true">$</span><code>{command}</code><button class="copy-command" type="button" aria-label={`Copy ${label} install command`}><Icon name="copy" /></button></> : <p>Go links to the Rust C ABI. <a href={`/docs/integrations/#${guide}`}>Build from source <Icon name="arrow" /></a></p>}
          </div>
        </div>)}
        <div class="install-help"><a data-integration-guide href="/docs/integrations/#node--express">Node integration guide <Icon name="arrow" /></a><span class="copy-status" role="status" aria-live="polite" /></div>
      </div>
      <dl class="runtime-facts"><div><dt>Runtime</dt><dd>Rust</dd></div><div><dt>Storage</dt><dd>Turso</dd></div><div><dt>Integrations</dt><dd>4 languages</dd></div><div><dt>License</dt><dd>Apache 2.0</dd></div></dl>
    </section>
    <section class="ownership landing-frame" id="capabilities" aria-labelledby="ownership-title">
      <div class="section-introduction"><h2 id="ownership-title">Your server.<br />Your identity.</h2><p>Mount Stargate in your application. Your application owns the HTTP server, TLS and configuration. Authentication stays close to the code it protects.</p></div>
      <dl class="capability-list">
        <div><dt>Sign in, your way.</dt><dd>Local email/password accounts, your OIDC provider, or both. Keep the choice inside your application.</dd></div>
        <div><dt>Give every key a purpose.</dt><dd>Scoped API keys with expiration and revocation. Secrets are shown once and stored as hashes.</dd></div>
        <div><dt>A place for every account.</dt><dd>An embedded panel for profiles, keys, sessions and administrator user management, with configurable branding.</dd></div>
      </dl>
      <a class="text-link" href="/docs/configuration/">Read the configuration & security guide <Icon name="arrow" /></a>
    </section>
    <section class="integration-example" aria-labelledby="runtime-title">
      <div class="integration-copy"><h2 id="runtime-title">One runtime.<br />Your stack.</h2><p>The same authentication logic, whether you build with Axum, Express, FastAPI or net/http.</p><a class="text-link" href="/docs/integrations/">Explore the integrations <Icon name="arrow" /></a></div>
      <IntegrationExamples />
    </section>
  </main>
</SiteLayout>
