---
import SiteLayout from '../layouts/SiteLayout.astro';
import RuntimeDiagram from '../components/RuntimeDiagram.astro';
import Icon from '../components/Icon.astro';
import '../styles/landing.css';
const integrations = [
  { id: 'rust', label: 'Rust', command: 'cargo add syntropika-stargate --rename stargate', guide: 'rust--axum' },
  { id: 'node', label: 'Node', command: 'npm install @syntropika/stargate', guide: 'node--express' },
  { id: 'python', label: 'Python', command: 'python -m pip install syntropika-stargate', guide: 'python--fastapi' },
  { id: 'go', label: 'Go', command: null, guide: 'go--nethttp' },
];
---
<SiteLayout title="Authentication inside your app" home>
  <main id="main-content">
    <section class="landing-hero landing-frame" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">Authentication<br />inside your app.</h1>
        <p>Email/password or OIDC sign-in, sessions and API keys. One Rust runtime, embedded in your existing server.</p>
        <div class="hero-actions"><a class="primary-link" href="/docs/">Get started <Icon name="arrow" /></a><a class="repository-link" href="https://github.com/syntropika/stargate"><Icon name="github" /><span>View on GitHub</span></a></div>
      </div>
      <RuntimeDiagram />
    </section>
    <section class="installation" aria-label="Install Stargate">
      <div class="landing-frame" data-installation>
        <div class="install-tabs" role="tablist" aria-label="Choose your language">
          {integrations.map(({ id, label, guide }) => <button type="button" role="tab" id={`tab-${id}`} aria-controls={`install-${id}`} aria-selected={id === 'node'} tabindex={id === 'node' ? 0 : -1} data-guide={guide}>{label}</button>)}
        </div>
        {integrations.map(({ id, label, command, guide }) => <div class="install-panel" id={`install-${id}`} role="tabpanel" aria-labelledby={`tab-${id}`} hidden={id !== 'node'} tabindex="0">
          <div class="install-command">
            {command ? <><span class="shell-prompt" aria-hidden="true">$</span><code>{command}</code><button class="copy-command" type="button" aria-label={`Copy ${label} install command`}><Icon name="copy" /></button></> : <p>Go links to the Rust C ABI. <a href={`/docs/integrations/#${guide}`}>Build from source <Icon name="arrow" /></a></p>}
          </div>
        </div>)}
        <div class="install-help"><a data-integration-guide href="/docs/integrations/#node--express">Node integration guide <Icon name="arrow" /></a><span class="copy-status" role="status" aria-live="polite" /></div>
      </div>
    </section>
    <section class="ownership landing-frame" aria-labelledby="ownership-title">
      <h2 id="ownership-title">Your server. Your identity.</h2>
      <p class="ownership-lead">Mount Stargate in your app. Your application owns the HTTP server, TLS and configuration.</p>
      <div class="ownership-details">
        <p class="ownership-description">Keep authentication alongside your application. Choose local accounts, OIDC, or both, and an embedded database, mount the account routes, then protect the endpoints that need an identity or explicit scopes.</p>
        <dl class="capability-list">
          <div><dt>Your choice of sign-in</dt><dd>Local email/password accounts, or your OIDC provider with PKCE, state and nonce validation.</dd></div>
          <div><dt>Sessions & API keys</dt><dd>Cookie sessions and scoped API keys with expiration and revocation.</dd></div>
          <div><dt>Account UI</dt><dd>An embedded panel for profiles, users, keys and sessions, with configurable branding.</dd></div>
        </dl>
      </div>
      <a class="text-link" href="/docs/configuration/">Read the configuration & security guide <Icon name="arrow" /></a>
    </section>
  </main>
  <script>
    const root = document.querySelector<HTMLElement>('[data-installation]');
    if (root) {
      const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
      const status = root.querySelector<HTMLElement>('.copy-status')!;
      const guide = root.querySelector<HTMLAnchorElement>('[data-integration-guide]')!;
      let selection = 0;
      function activate(tab: HTMLButtonElement) {
        selection++;
        for (const item of tabs) {
          const active = item === tab;
          item.setAttribute('aria-selected', String(active));
          item.tabIndex = active ? 0 : -1;
        }
        for (const panel of panels) panel.hidden = panel.id !== tab.getAttribute('aria-controls');
        guide.href = `/docs/integrations/#${tab.dataset.guide}`;
        guide.firstChild!.textContent = `${tab.textContent} integration guide `;
        status.textContent = '';
      }
      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => activate(tab));
        tab.addEventListener('keydown', event => {
          let next: number;
          switch (event.key) {
            case 'ArrowRight': next = (index + 1) % tabs.length; break;
            case 'ArrowLeft': next = (index + tabs.length - 1) % tabs.length; break;
            case 'Home': next = 0; break;
            case 'End': next = tabs.length - 1; break;
            default: return;
          }
          event.preventDefault();
          activate(tabs[next]);
          tabs[next].focus();
        });
      });
      root.querySelectorAll<HTMLButtonElement>('.copy-command').forEach(button => {
        button.addEventListener('click', async () => {
          const attempt = selection;
          const command = button.parentElement!.querySelector('code')!.textContent!;
          button.disabled = true;
          try {
            await navigator.clipboard.writeText(command);
            if (selection === attempt) status.textContent = 'Command copied.';
          } catch {
            if (selection === attempt) status.textContent = 'Could not copy. Select the command and copy it manually.';
          } finally {
            button.disabled = false;
          }
        });
      });
    }
  </script>
</SiteLayout>
