---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Page not found">
  <main id="main-content" class="doc-content not-found">
    <h1>That page is outside the gate.</h1>
    <p>The address may have changed. You can return to Stargate or browse the documentation.</p>
    <p><a href="/">Go to the homepage</a> · <a href="/docs/">Read the documentation</a></p>
  </main>
</SiteLayout>
