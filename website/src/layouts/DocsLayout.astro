---
import SiteLayout from './SiteLayout.astro';
import { guides } from '../lib/guides';
interface Props { title: string; current?: string; description?: string; }
const { title, current = '', description } = Astro.props;
---
<SiteLayout title={title} description={description} docs>
  <div class="docs-shell">
    <aside class="docs-navigation" id="docs-navigation">
      <div class="docs-navigation-inner">
        <p class="docs-navigation-title">Documentation</p>
        <nav aria-label="Documentation">
          <a href="/docs/" aria-current={!current ? 'page' : undefined}>Getting started</a>
          {guides.map(guide => <a href={`/docs/${guide.id}/`} aria-current={current === guide.id ? 'page' : undefined}>{guide.label}</a>)}
          <a class="docs-project-link" href="https://github.com/syntropika/stargate">GitHub</a>
        </nav>
      </div>
    </aside>
    <main id="main-content" class="doc-content"><slot /></main>
  </div>
</SiteLayout>

<script>
  document.querySelectorAll<HTMLElement>('.doc-content pre').forEach(block => {
    block.tabIndex = 0;
  });
  const toggle = document.querySelector<HTMLButtonElement>('.docs-toggle');
  const navigation = document.querySelector<HTMLElement>('#docs-navigation');
  if (toggle && navigation) {
    const mobile = window.matchMedia('(max-width: 45rem)');
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', `${open ? 'Close' : 'Open'} documentation navigation`);
      navigation.classList.toggle('is-open', open);
    };
    toggle.hidden = false;
    document.body.classList.add('docs-menu-ready');
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && mobile.matches && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    mobile.addEventListener('change', () => {
      if (navigation.contains(document.activeElement) || document.activeElement === toggle) {
        if (mobile.matches) toggle.focus();
        else navigation.querySelector<HTMLAnchorElement>('a[aria-current]')?.focus();
      }
      setOpen(false);
    });
  }
</script>
