---
import SiteLayout from './SiteLayout.astro';
import { guides } from '../lib/guides';
import Icon from '../components/Icon.astro';
import '../styles/docs.css';
const readingFade = {
  old: { name: 'reading-fade-out', duration: '100ms', easing: 'cubic-bezier(0.23, 1, 0.32, 1)', fillMode: 'both' },
  new: { name: 'reading-fade-in', duration: '160ms', easing: 'cubic-bezier(0.23, 1, 0.32, 1)', fillMode: 'both' },
};
interface Props { title: string; current?: string; description?: string; }
const { title, current = '', description } = Astro.props;
const pages = [{ id: '', label: 'Getting started' }, ...guides];
const pageIndex = pages.findIndex(page => page.id === current);
const previous = pages[pageIndex - 1];
const next = pages[pageIndex + 1];
const pageHref = (id: string) => id ? `/docs/${id}/` : '/docs/';
---
<SiteLayout title={title} description={description} docs>
  <div class="docs-section-navigation">
    <button class="docs-toggle" type="button" aria-expanded="false" aria-controls="docs-navigation" hidden>
      <span>Documentation</span>
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
    </button>
    <nav class="docs-navigation" id="docs-navigation" aria-label="Documentation">
      {pages.map(page => <a href={pageHref(page.id)} aria-current={current === page.id ? 'page' : undefined}>{page.label}</a>)}
    </nav>
  </div>
  <main id="main-content" class="docs-main" transition:name="reading-content" transition:animate={{ forwards: readingFade, backwards: readingFade }}>
    <article class="doc-content"><slot /></article>
    <nav class="docs-pagination" aria-label="Guide pages">
      {previous && <a class="previous-guide" href={pageHref(previous.id)}><span>Previous guide</span><strong><Icon name="arrow" />{previous.label}</strong></a>}
      {next && <a class="next-guide" href={pageHref(next.id)}><span>Next guide</span><strong>{next.label}<Icon name="arrow" /></strong></a>}
    </nav>
  </main>
</SiteLayout>
